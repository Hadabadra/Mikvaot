{
  "id": "com.hadabadra.mikvaot",
  "name": "מקוואות",
  "version": "1.3.2",
  "description": "מדריך מקוואות נשים, גברים וכלים בארץ ובחו\"ל: כתובת, טלפון, שעות ונגישות, לפי עיר או מיקום. כולל מועצות דתיות, תזכורת ויומן.",
  "author": "לזש\"ק לרמב\"ר ומבק\"י",
  "schemaVersion": 1,
  "sdkVersion": "1.x",
  "stability": "beta",
  "minAppVersion": "0.9.98",
  "entrypoint": "index.html",
  "permissions": [
    "app.open_url",
    "app.info.read",
    "calendar.read",
    "events.subscribe:theme.changed",
    "events.subscribe:calendar.city_changed",
    "plugin.storage.read",
    "plugin.storage.write",
    "ui.feedback",
    "network.localhost",
    "fs.user_files.read",
    "notifications.system",
    "published_data.write"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "127.0.0.1",
      "localhost"
    ]
  },
  "contributes": {
    "toolTab": {
      "title": "מקוואות",
      "order": 216,
      "defaultPinned": false,
      "iconName": "drop_24_regular"
    }
  },
  "homepage": "https://github.com/Hadabadra/Mikvaot",
  "icon": "icon.png"
}
