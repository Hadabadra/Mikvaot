{
  "id": "com.hadabadra.mikvaot",
  "name": "מקוואות",
  "version": "2.1.0",
  "description": "מדריך מקוואות נשים, גברים וכלים בארץ ובחו\"ל: כתובת, טלפון ושעות לפי עיר או מיקום. הכל בתוך התוסף — אין צורך באינטרנט מלבד ההורדה.",
  "author": "לזש\"ק לרמב\"ר ומבק\"י",
  "schemaVersion": 1,
  "sdkVersion": "1.x",
  "stability": "stable",
  "minAppVersion": "0.9.98.3",
  "entrypoint": "index.html",
  "permissions": [
    "app.open_url",
    "app.info.read",
    "calendar.read",
    "events.subscribe:theme.changed",
    "events.subscribe:calendar.city_changed",
    "plugin.storage.read",
    "plugin.storage.write",
    "ui.feedback",
    "network.localhost",
    "fs.user_files.read",
    "notifications.system",
    "published_data.write",
    "plugin.open_other",
    "network.access",
    "app.startup_contributions",
    "search.field_actions",
    "settings.read",
    "library.books.read",
    "reader.open",
    "reader.toolbar",
    "fs.user_files.write"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "127.0.0.1",
      "localhost",
      "https://nominatim.openstreetmap.org/search"
    ]
  },
  "contributes": {
    "toolTab": {
      "title": "מקוואות",
      "order": 216,
      "defaultPinned": false,
      "iconName": "drop_24_regular"
    },
    "startup": {
      "searchFieldActions": [
        {
          "id": "find-mikveh",
          "title": "חיפוש מקווה לפי העיר או הרחוב שבשדה",
          "icon": "drop_24_regular",
          "activeIcon": "drop_24_filled",
          "fields": [
            "library",
            "fullText"
          ],
          "visibleWhen": "nonEmptyText"
        }
      ],
      "toolbarItems": [
        {
          "id": "open-mikvaot",
          "title": "מקוואות",
          "icon": "drop_24_regular",
          "contexts": [
            "reader-text"
          ],
          "openPlugin": true,
          "when": {
            "not": {
              "storage": {
                "key": "hideToolbar",
                "equals": true
              }
            }
          }
        }
      ]
    }
  },
  "homepage": "https://github.com/Hadabadra/Mikvaot",
  "icon": "icon.png"
}
